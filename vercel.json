{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/brand.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/google-news.xml",
      "destination": "/api/seo-google-news"
    },
    {
      "source": "/archive",
      "destination": "/api/seo-archive"
    },
    {
      "source": "/archive/",
      "destination": "/api/seo-archive"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/seo-news-sitemap"
    },
    {
      "source": "/india/:story",
      "destination": "/api/seo-article/india/:story"
    },
    {
      "source": "/india",
      "destination": "/api/seo-section/india"
    },
    {
      "source": "/india/",
      "destination": "/api/seo-section/india"
    },
    {
      "source": "/politics/:story",
      "destination": "/api/seo-article/politics/:story"
    },
    {
      "source": "/politics",
      "destination": "/api/seo-section/politics"
    },
    {
      "source": "/politics/",
      "destination": "/api/seo-section/politics"
    },
    {
      "source": "/world/:story",
      "destination": "/api/seo-article/world/:story"
    },
    {
      "source": "/world",
      "destination": "/api/seo-section/world"
    },
    {
      "source": "/world/",
      "destination": "/api/seo-section/world"
    },
    {
      "source": "/business/:story",
      "destination": "/api/seo-article/business/:story"
    },
    {
      "source": "/business",
      "destination": "/api/seo-section/business"
    },
    {
      "source": "/business/",
      "destination": "/api/seo-section/business"
    },
    {
      "source": "/technology/:story",
      "destination": "/api/seo-article/technology/:story"
    },
    {
      "source": "/technology",
      "destination": "/api/seo-section/technology"
    },
    {
      "source": "/technology/",
      "destination": "/api/seo-section/technology"
    },
    {
      "source": "/sports/:story",
      "destination": "/api/seo-article/sports/:story"
    },
    {
      "source": "/sports",
      "destination": "/api/seo-section/sports"
    },
    {
      "source": "/sports/",
      "destination": "/api/seo-section/sports"
    },
    {
      "source": "/entertainment/:story",
      "destination": "/api/seo-article/entertainment/:story"
    },
    {
      "source": "/entertainment",
      "destination": "/api/seo-section/entertainment"
    },
    {
      "source": "/entertainment/",
      "destination": "/api/seo-section/entertainment"
    },
    {
      "source": "/science/:story",
      "destination": "/api/seo-article/science/:story"
    },
    {
      "source": "/science",
      "destination": "/api/seo-section/science"
    },
    {
      "source": "/science/",
      "destination": "/api/seo-section/science"
    },
    {
      "source": "/health/:story",
      "destination": "/api/seo-article/health/:story"
    },
    {
      "source": "/health",
      "destination": "/api/seo-section/health"
    },
    {
      "source": "/health/",
      "destination": "/api/seo-section/health"
    },
    {
      "source": "/hindi/:story",
      "destination": "/api/seo-article/hindi/:story"
    },
    {
      "source": "/hindi",
      "destination": "/api/seo-section/hindi"
    },
    {
      "source": "/hindi/",
      "destination": "/api/seo-section/hindi"
    }
  ],
  "crons": [
    {
      "path": "/api/newsletter/daily",
      "schedule": "0 4 * * *"
    }
  ]
}

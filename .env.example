# PostgreSQL connection string from your database provider
DATABASE_3URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Website-hosted Admin Room; keeps the phone bridge out of the login path.
POLITICSHUB_ADMIN_BACKEND=hosted
# A stable deployment secret signs HttpOnly administrator session cookies.
FLASK_SECRET_KEY=
# Optional hashed owner bootstrap; applies only when admin_users is empty.
# ADMIN_USERS_JSON={"your_username":"scrypt:..."}

# Server-side India news sources
NEWSAPI_KEY=
NEWSDATA_API_KEY=
NEWS_API_TIMEOUT_SECONDS=12

# Newsletter sender: existing Gmail SMTP remains the default.
GMAIL_APP_PASSWORD=

# Optional: switch to an authenticated transactional-email/SMTP provider.
# Use ONLY after verifying a sending address on politicshub.in and publishing
# the provider-supplied SPF/DKIM/DMARC DNS records. Do not invent DNS keys.
# Setting NEWSLETTER_SMTP_HOST enables strict configuration checks and does
# NOT silently fall back to the Gmail address if the setup is incomplete.
NEWSLETTER_SMTP_HOST=
NEWSLETTER_SMTP_PORT=465
NEWSLETTER_SMTP_USER=
NEWSLETTER_SMTP_PASSWORD=
NEWSLETTER_FROM_EMAIL=


# Optional zero-cost Google Apps Script sender path for SMTP DKIM rejection.
# Deploy integrations/gmail-apps-script/Code.gs under politicshub.in@gmail.com,
# authorize MailApp once, then set BOTH variables in Vercel Production.
# Keep secrets out of source control and do not use a third-party script URL.
NEWSLETTER_GMAIL_RELAY_URL=
NEWSLETTER_GMAIL_RELAY_TOKEN=

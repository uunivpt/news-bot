# PostgreSQL connection string from your database provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional Microsoft Phi-4 AI layer (keep the API key server-side only)
PHI4_ENABLED=true
PHI4_API_KEY=
PHI4_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
PHI4_MODEL=Phi-4
PHI4_TIMEOUT_SECONDS=25


# Server-side India news sources
NEWSAPI_KEY=
NEWSDATA_API_KEY=
NEWS_API_TIMEOUT_SECONDS=12

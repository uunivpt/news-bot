# PostgreSQL connection string from your database provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Server-side India news sources
NEWSAPI_KEY=
NEWSDATA_API_KEY=
NEWS_API_TIMEOUT_SECONDS=12

# Newsletter sender: existing Gmail SMTP remains the default.
GMAIL_APP_PASSWORD=

# Optional: switch to an authenticated transactional-email/SMTP provider.
# Use ONLY after verifying a sending address on politicshub.in and publishing
# the provider-supplied SPF/DKIM/DMARC DNS records. Do not invent DNS keys.
# Setting NEWSLETTER_SMTP_HOST enables strict configuration checks and does
# NOT silently fall back to the Gmail address if the setup is incomplete.
NEWSLETTER_SMTP_HOST=
NEWSLETTER_SMTP_PORT=465
NEWSLETTER_SMTP_USER=
NEWSLETTER_SMTP_PASSWORD=
NEWSLETTER_FROM_EMAIL=
